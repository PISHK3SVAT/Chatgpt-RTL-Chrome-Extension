{
  "manifest_version": 3,
  "name": "Chatgpt Rtl Chrrome Extension",
  "version": "1.0.0",
  "description": "This Extension convert all [dir:auto] to [dir:rtl]",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ],
      "run_at": "document_idle"
    }
  ]
}